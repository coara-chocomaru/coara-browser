<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_browser_window">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@drawable/bg_browser_toolbar"
            android:elevation="6dp"
            android:minHeight="70dp"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:contentInsetEndWithActions="0dp"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
            app:title=""
            app:titleCentered="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/urlContainer"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D9E0E7"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_browser_url_container"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/favicon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Favicon"
                            android:src="@drawable/transparent_vector" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/urlEditText"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:hint="Search or type URL"
                            android:imeOptions="actionGo"
                            android:includeFontPadding="false"
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:textColor="@android:color/black"
                            android:textColorHint="#69707A"
                            android:textSize="15sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:minWidth="64dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Go"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="24dp"
                    app:backgroundTint="@color/colorPrimary"
                    android:textColor="@android:color/white" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewTab"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="47dp"
                    android:text="+"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    app:cornerRadius="24dp"
                    app:backgroundTint="@android:color/white"
                    android:textColor="@color/colorPrimary"
                    app:strokeColor="#D9E0E7"
                    app:strokeWidth="1dp" />
                <TextView
                    android:id="@+id/tabCountTextView"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_browser_chip"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_browser_window">

            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
